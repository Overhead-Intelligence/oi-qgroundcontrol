                "usb",
                "correction"
            ],
            "showWhen": "QGroundControl.settingsManager.autoConnectSettings.userVisible",
            "controls": [
                {
                    "setting": "autoConnectSettings.autoConnectRTKGPS"
                }
            ]
        },
        {
            "heading": "Android Serial",
            "keywords": [
                "serial",
                "posix",
                "uart",
                "tty",
                "android"
            ],
            "controls": [
